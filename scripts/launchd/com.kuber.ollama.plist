<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.kuber.ollama</string>
  <key>ProgramArguments</key><array><string>__KUBER_DIR__/tools/ollama/ollama</string><string>serve</string></array>
  <key>EnvironmentVariables</key><dict><key>OLLAMA_HOST</key><string>127.0.0.1:11434</string><key>OLLAMA_KEEP_ALIVE</key><string>2m</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__KUBER_DIR__/data/logs/ollama.log</string>
  <key>StandardErrorPath</key><string>__KUBER_DIR__/data/logs/ollama.log</string>
</dict></plist>
